        </mxCell>

        <mxCell id="n7" value="Buổi tư vấn hoàn tất&lt;br&gt;&lt;i&gt;Session completed&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#C0392B;strokeWidth=1.6;fontSize=12;" vertex="1" parent="1">
