<mxfile host="app.diagrams.net">
  <diagram name="Mentor Booking Activity Diagram" id="mentor-booking-activity">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="920" pageHeight="830" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Decorative frame -->
        <mxCell id="frame" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1c1c1a;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="880" height="750" as="geometry" />
        </mxCell>
        <mxCell id="titleBar" value="Mentor Booking Activity Diagram" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3F3EE;strokeColor=#1c1c1a;strokeWidth=1.5;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="880" height="34" as="geometry" />
        </mxCell>
        <mxCell id="laneUserHdr" value="Người dùng / User" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1c1c1a;strokeWidth=1.3;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="54" width="440" height="26" as="geometry" />
        </mxCell>
        <mxCell id="laneSysHdr" value="Hệ thống / System" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1c1c1a;strokeWidth=1.3;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="460" y="54" width="440" height="26" as="geometry" />
        </mxCell>
        <mxCell id="divider" style="endArrow=none;html=1;strokeColor=#1c1c1a;strokeWidth=1.3;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="460" y="20" as="sourcePoint" />
            <mxPoint x="460" y="770" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Nodes -->
        <mxCell id="n1" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1c1c1a;strokeColor=#1c1c1a;" vertex="1" parent="1">
          <mxGeometry x="224" y="94" width="32" height="32" as="geometry" />
        </mxCell>

        <mxCell id="n2" value="Chọn mentor &amp;amp; khung giờ&lt;br&gt;&lt;i&gt;Pick mentor &amp;amp; time slot&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#C0392B;strokeWidth=1.6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="140" y="163" width="200" height="54" as="geometry" />
        </mxCell>

        <mxCell id="n3" value="Xác nhận đặt lịch&lt;br&gt;&lt;i&gt;Confirm booking&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#C0392B;strokeWidth=1.6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="140" y="243" width="200" height="54" as="geometry" />
        </mxCell>

        <mxCell id="s1" value="Tạo booking (chờ thanh toán)&lt;br&gt;&lt;i&gt;Create booking (pending)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#C0392B;strokeWidth=1.6;fontSize=11.5;" vertex="1" parent="1">
          <mxGeometry x="580" y="243" width="200" height="54" as="geometry" />
        </mxCell>

        <mxCell id="s2" value="Hiện QR chuyển khoản&lt;br&gt;&lt;i&gt;Show transfer QR&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#C0392B;strokeWidth=1.6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="580" y="323" width="200" height="54" as="geometry" />
        </mxCell>

        <mxCell id="n4" value="Chuyển khoản qua QR&lt;br&gt;&lt;i&gt;Bank transfer via QR&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#C0392B;strokeWidth=1.6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="140" y="323" width="200" height="54" as="geometry" />
        </mxCell>

        <mxCell id="s3" value="Giao dịch khớp?&lt;br&gt;&lt;i&gt;Transfer matched?&lt;/i&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#C0392B;strokeWidth=1.6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="390" width="160" height="80" as="geometry" />
