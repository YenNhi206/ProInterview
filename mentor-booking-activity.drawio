        <mxCell id="s5" value="Mentor hoàn thành buổi, cộng thu nhập&lt;br&gt;&lt;i&gt;Mentor completes, credit earnings&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#C0392B;strokeWidth=1.6;fontSize=11;" vertex="1" parent="1">
