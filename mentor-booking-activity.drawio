        <mxCell id="n6" value="Tham gia buổi tư vấn&lt;br&gt;&lt;i&gt;Attend session&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#C0392B;strokeWidth=1.6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="140" y="573" width="200" height="54" as="geometry" />
