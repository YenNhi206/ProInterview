        <mxCell id="caption" value="Figure X.X.X : Mentor Booking (Đặt lịch Mentor)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF176;strokeColor=none;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="780" width="880" height="34" as="geometry" />
