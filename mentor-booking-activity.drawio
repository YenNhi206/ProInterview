        <mxCell id="s4" value="Xác nhận thanh toán, thông báo mentor&lt;br&gt;&lt;i&gt;Confirm payment, notify mentor&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#C0392B;strokeWidth=1.6;fontSize=11;" vertex="1" parent="1">
