        <mxCell id="n5" value="Xem lịch đã xác nhận&lt;br&gt;&lt;i&gt;See confirmed booking&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#C0392B;strokeWidth=1.6;fontSize=12;" vertex="1" parent="1">
