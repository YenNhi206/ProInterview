        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#C0392B;strokeWidth=1.5;" edge="1" parent="1" source="s2" target="n4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#C0392B;strokeWidth=1.5;" edge="1" parent="1" source="n4" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="Chưa khớp / Not matched" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#C0392B;strokeWidth=1.5;fontSize=10;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="s3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="800" y="405" /><mxPoint x="800" y="455" /></Array></mxGeometry></mxCell>
